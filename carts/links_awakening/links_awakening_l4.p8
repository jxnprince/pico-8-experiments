pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  palt(0,false) -- unset transparency for black
  palt(6,true)  -- set light grey to alpha
  poke(0x5f2e,1)  -- set secret color palatte
  pal(11,11+128,1) -- darken the light green

  px=64 -- pp x pos
  py=64 -- pp y pos

	 mode="idle"

	 -- pp ani frames
  walkanil={4,6}  --left
  walkanir={8,10} --right
  walkaniu={12,14}--up
  walkanid={0,2}  --down

  -- dynamic pp colison boxes
  coll={4,9,4,12}  --left
  colr={11,9,11,12}--right
  colu={6,7,9,7}   --up
  cold={6,15,9,15} --down
  col=cold

  panit=0 -- pp animation timer
  paniframe=1 -- curr pp ani frame
  pani=walkanid -- set default

  lastbtn=0 --last button pressed
  tframe=0
end


function _draw()
		cls(5)
  tframe+=1
  map() -- set default map
  spr(pani[paniframe],px,py,2,2) -- draw link

  --collision debug
   for p in all(points) do
     pset(p[1],p[2],p[3])
   end
   
end


function _update60()
  checkbutts()
  if tframe%20==0 then
    for x=0,15 do
      for y=0,15 do
        local tle=mget(x,y)
        if tle>=37 and tle<=39 then
          mset(x,y,tle+1)
        elseif tle==40 then
          mset(x,y,37)
        end
      end
    end
  end
end


function moveplayer()
  px+=psx
  py+=psy
end


function aniplayer()
  panit+=1 -- increment animation timer
  if panit>=8 then -- change sprite every 8 frames
    panit=0
    paniframe+=1
    if paniframe>count(pani) then
      paniframe=1
    end
  end
end


function checkbutts()
 
  local press=0 -- no. of buttons pressed
  psx=0 -- pp speed x
  psy=0 -- pp speed y

	if btn(⬅️) then
    psx=-1
    pani=walkanil
    press+=1
    col=coll
  end
  if btn(➡️) then
    psx=1
    pani=walkanir
    press+=1
    col=colr
end
  if btn(⬆️) then
    psy=-1
    pani=walkaniu
    press+=1
    col=colu
  end
  if btn(⬇️) then
    psy=1
    pani=walkanid
    press+=1
    col=cold
  end

  if press>0 then
    -- nomralize the vector for diagonals
    if press>=2 then
      psx=psx*0.7
      psy=psy*0.7
    end

    --anti cobblestone
  if lastbtn!=btn() then
  px=flr(px)
  py=flr(py)   
  end
  
  local nocol=checkmove(psx,psy)
  
  if nocol==false then
  if press==1 then
    --corner slip
    local slpx=psx==0 and 1 or 0
    local slpy=psy==0 and 1 or 0
    
    local j=1
    repeat
       for i=1,3 do
        local slpdx=psx+slpx*i*j
        local slpdy=psy+slpy*i*j
        if checkmove(slpdx,slpdy) then
          psx=sgn(slpdx)
          psy=sgn(slpdy)
          nocol=true
          break
        end
       end
        j-=2
    until nocol or j<-1
   
  elseif press>=2 then
    --diagnoal slide
      if checkmove(psx,0) then
        psy=0
        psx=psx/0.7
        nocol=true
      elseif checkmove(0,psy) then
        psx=0
        psy=psy/0.7
        nocol=true   
      end
  end
  end
  
    if nocol then
      moveplayer()
    end
     
    aniplayer()
else
  panit=7
  paniframe=1
end
 
lastbtn=btn()
end


function checkmove(dx,dy)
  local newx=px+dx
  local newy=py+dy
  
  points={
    {newx+col[1],newy+col[2],7},
    {newx+col[3],newy+col[4],7}
  }
  for p in all(points) do
    if not walkable(p[1],p[2]) then
      p[3]=8
      return false
    end
  end
  return true
end
  
  
function walkable(pnx,pny)
-- if the target tile has flag 1 set
-- then activate collision
return not fget(mget(pnx/8,pny/8),0)
end


