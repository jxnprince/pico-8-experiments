pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 -- set secret color palatte
 poke(0x5f2e,1)
 -- darken the light green
 pal(11,11+128,1)
 -- unset transparency for black
 palt(0,false)
 -- set light grey to alpha
 palt(6,true)

 -- pp starting vars
 px=64  --x pos
 py=64 -- x pos

	mode="idle"

	-- pp ani frames
	walkanil={4,6} -- left
	walkanir={8,10} -- right
	walkaniu={12,14} -- up
	walkanid={0,2} -- down
	
	panit=0 -- pp animation timer
	paniframe=1 -- curr pp ani frame
	pani=walkanid -- set default
	
	lastbtn=0
end


function _draw()
 cls(5) -- 	clear screen
 map(0,0,0,0) -- set default map
 spr(pani[paniframe],px,py,2,2) -- draw link
	
 --collision debug
 for p in all(points) do
  pset(p[1],p[2],p[3])
 end
end


function _update60()
	checkbutts()
end


function moveplayer()
 px+=psx
 py+=psy
end


function aniplayer()
	 -- increment animation timer
 panit+=1
 -- change sprite every 8 frames
 if panit>=8 then
  panit=0
  paniframe+=1
  if paniframe>count(pani) then
   paniframe=1
  end
 end
end


function checkbutts()
 -- no. of buttons pressed
 local press=0

 -- pp speed
 psx=0
 psy=0

 if btn(⬅️) then
  psx=-1
  pani=walkanil
  press+=1
 end
 if btn(➡️) then
  psx=1
  pani=walkanir
  press+=1
 end
 if btn(⬆️) then
  psy=-1
  pani=walkaniu
  press+=1
 end
 if btn(⬇️) then
  psy=1
  pani=walkanid
  press+=1
 end

 if press>0 then
  -- nomralize the vector for diagonals
  if press>=2 then
   psx=psx*0.7
   psy=psy*0.7
  end

		-- anti-cobblestone
  if lastbtn!=btn() then
   px=flr(px)
   py=flr(py)   
  end
 
 	local nocol=checkmove(psx,psy)

		if not nocol and press>=2 then
		 if checkmove(psx,0) then
		  psy=0
		  nocol=true
		 elseif checkmove(0,psy) then
		  psx=0
		  nocol=true
		 end
		end
	
		if nocol then
		 moveplayer()
		end

		aniplayer()

	else
		panit=7
		paniframe=1
	end
 
 lastbtn=btn()
end


function checkmove(dx,dy)
 local newx=px+dx
 local newy=py+dy

	points={
	 {newx+4,newy+7,7},  -- top l
	 {newx+12,newy+7,7}, -- top r 
	 {newx+4,newy+14,7}, -- bot l
	 {newx+12,newy+14,7} -- bot r
	}

	for p in all(points) do
	 if not walkable(p[1], p[2]) then
	  p[3]=8
	  return false
	 end
	end

	return true
end


function walkable(pnx,pny)
 -- if the target tile has flag 1 set
 -- then activate collision
 return fget(
  mget(pnx/8,pny/8),0
 )==false
end


